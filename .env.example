# HermesX 环境变量
# 复制此文件为 .env 并填入你的 Binance API Key

# ===== 生产环境（实盘） =====
# Binance 主网 API Key（需要开通合约交易权限）
BINANCE_API_KEY=
BINANCE_API_SECRET=

# ===== 测试网环境（模拟交易走币安测试网） =====
# 设为 true 后，模拟模式将使用币安测试网下单
BINANCE_TESTNET=true
# 测试网 API Key（从 https://testnet.binancefuture.com/ 获取）
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=

# ===== 通用配置 =====
# 单个方向最大开仓数量（U本位合约的币数量，如 0.01）
MAX_POSITION_QTY=0.01
